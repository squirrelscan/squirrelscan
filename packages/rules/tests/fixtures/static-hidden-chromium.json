  {"name": "inside a marquee with the hidden attribute", "html": "<marquee hidden><b id=\"t\">x</b></marquee>", "chromium": "shown"},
  {"name": "marquee with popover", "html": "<marquee id=\"t\" popover>x</marquee>", "chromium": "shown"},
  {"name": "embed with the hidden attribute", "html": "<embed id=\"t\" hidden>", "chromium": "shown"},
  {"name": "hidden HTML inside svg foreignObject", "html": "<svg><foreignObject width=\"9\" height=\"9\"><div hidden><b id=\"t\">x</b></div></foreignObject></svg>", "chromium": "hidden"},
  {"name": "style: class rule", "html": "<style>.x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: id rule", "html": "<style>#t{display:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: tag rule", "html": "<style>b{display:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: upper-case tag", "html": "<style>B{display:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: attribute presence", "html": "<style>[data-x]{display:none}</style><b id=\"t\" data-x>x</b>", "chromium": "hidden"},
  {"name": "style: attribute value", "html": "<style>[data-x=\"a\"]{display:none}</style><b id=\"t\" data-x=\"a\">x</b>", "chromium": "hidden"},
  {"name": "style: attribute value, other case", "html": "<style>[data-x=\"A\"]{display:none}</style><b id=\"t\" data-x=\"a\">x</b>", "chromium": "shown"},
  {"name": "style: attribute s flag", "html": "<style>[data-x=\"a\" s]{display:none}</style><b id=\"t\" data-x=\"a\">x</b>", "chromium": "shown"},
