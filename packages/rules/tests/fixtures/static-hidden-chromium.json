  {"name": "style: empty selector voids the list", "html": "<style>.x,,.y{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: trailing combinator", "html": "<style>.x >{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: leading combinator", "html": "<style>> .x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: type with spaces", "html": "<style type=\" text/css \">.x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: type upper case", "html": "<style type=\"TEXT/CSS\">.x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: type other", "html": "<style type=\"text/less\">.x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: media print", "html": "<style media=\"print\">.x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: media screen", "html": "<style media=\"screen\">.x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: unquoted url swallows the rule", "html": "<style>.a{background:url(}.x{display:none}.c{)}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: parenthesis group swallows the rule", "html": "<style>.a{b:(}.x{display:none}.c{)}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: bracket group swallows the rule", "html": "<style>.a{b:[}.x{display:none}.c{]}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: no-break space in the selector", "html": "<style>.x\u00a0{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: more specific rule shows it", "html": "<style>.x{display:none}.x.y{display:block}</style><b id=\"t\" class=\"x y\">x</b>", "chromium": "shown"},
  {"name": "style: id beats class", "html": "<style>#t{display:block}.x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: later rule shows it", "html": "<style>.x{display:none}.x{display:inline}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: later rule hides it", "html": "<style>.x{display:inline}.x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: inline style shows it", "html": "<style>.x{display:none}</style><b id=\"t\" class=\"x\" style=\"display:inline\">x</b>", "chromium": "shown"},
  {"name": "style: !important beats inline", "html": "<style>.x{display:none !important}</style><b id=\"t\" class=\"x\" style=\"display:inline\">x</b>", "chromium": "hidden"},
  {"name": "style: inline !important beats rule !important", "html": "<style>.x{display:none !important}</style><b id=\"t\" class=\"x\" style=\"display:inline !important\">x</b>", "chromium": "shown"},
  {"name": "style: two blocks, second !important shows it", "html": "<style>.x{display:none !important}</style><style>.x{display:block !important}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: @media shows it again", "html": "<style>.x{display:none}@media screen{.x{display:block}}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: ancestor class", "html": "<style>.x{display:none}</style><div class=\"x\"><b id=\"t\">x</b></div>", "chromium": "hidden"},
  {"name": "style: ancestor tag.class", "html": "<style>div.x{display:none}</style><div class=\"x\"><span><b id=\"t\">x</b></span></div>", "chromium": "hidden"},
  {"name": "style: visibility on a container", "html": "<style>.x{visibility:hidden}</style><div class=\"x\"><b id=\"t\">x</b></div>", "chromium": "hidden"},
  {"name": "style: visibility set back on the child", "html": "<style>.x{visibility:hidden}#t{visibility:visible}</style><div class=\"x\"><b id=\"t\">x</b></div>", "chromium": "shown"},
  {"name": "style: visibility set back by a hover rule", "html": "<style>.x{visibility:hidden}.x b:hover{visibility:visible}</style><div class=\"x\"><b id=\"t\">x</b></div>", "chromium": "hidden"},
  {"name": "style: escaped class", "html": "<style>.md\\:hidden{display:none}</style><b id=\"t\" class=\"md:hidden\">x</b>", "chromium": "hidden"},
  {"name": "style: escaped class shown again in @media", "html": "<style>.md\\:hidden{display:none}@media (min-width:1px){.md\\:block{display:block}}</style><b id=\"t\" class=\"md:hidden md:block\">x</b>", "chromium": "shown"},
  {"name": "style: class case differs", "html": "<style>.X{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: id case differs", "html": "<style>#T{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: display revert", "html": "<style>.x{display:none}.x{display:revert}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: inside a template", "html": "<template><style>.x{display:none}</style></template><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: after the element", "html": "<b id=\"t\" class=\"x\">x</b><style>.x{display:none}</style>", "chromium": "hidden"},
  {"name": "style: comment between two classes", "html": "<style>.x/**/.y{display:none}</style><b id=\"t\" class=\"x y\">x</b>", "chromium": "hidden"},
  {"name": "style: universal", "html": "<style>*{display:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: descendant combinator", "html": "<style>.a .x{display:none}</style><div class=\"a\"><b id=\"t\" class=\"x\">x</b></div>", "chromium": "hidden"},
  {"name": "style: :not() rule shows it", "html": "<style>.x{display:none}.x:not(.y){display:block}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: :is() rule shows it", "html": "<style>.x{display:none}:is(b){display:block}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: CSS nesting shows it", "html": "<style>.x{display:none; &.y{display:block}}</style><b id=\"t\" class=\"x y\">x</b>", "chromium": "shown"},
  {"name": "style: nested @media display none (pub#1013)", "html": "<style>b { @media (min-width: 0) { display: none } }</style><b id=\"t\"></b>", "chromium": "hidden"},
  {"name": "style: hidden attribute shown by a class", "html": "<style>.flex{display:flex}</style><div hidden class=\"flex\"><b id=\"t\">x</b></div>", "chromium": "shown"},
  {"name": "style: hidden attribute shown by [hidden]", "html": "<style>[hidden]{display:block}</style><div hidden><b id=\"t\">x</b></div>", "chromium": "shown"},
  {"name": "style: reset [hidden] display:none", "html": "<style>[hidden]{display:none !important}</style><div hidden><b id=\"t\">x</b></div>", "chromium": "hidden"},
  {"name": "style: important in the middle", "html": "<style>.x{display:none !important; display:block}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: all shorthand after", "html": "<style>.x{display:none}.x{all:initial}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: keyframes", "html": "<style>@keyframes k{from{visibility:visible}to{visibility:visible}}.x{visibility:hidden}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: input type value case-blind", "html": "<style>[type=checkbox]{display:none}</style><input id=\"t\" type=\"CHECKBOX\">", "chromium": "hidden"},
  {"name": "style: closed dialog shown by a rule", "html": "<style>dialog{display:block}</style><dialog><b id=\"t\">x</b></dialog>", "chromium": "shown"},
  {"name": "style: external stylesheet after shows it", "html": "<style>.x{display:none}</style><link rel=\"stylesheet\" href=\"data:text/css,.x%7Bdisplay:block%7D\"><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: @import before the rule", "html": "<style>@import url(\"data:text/css,.x%7Bdisplay:block%7D\");.x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: svg style block shows it", "html": "<style>.x{display:none}</style><svg><style>.x{display:block}</style></svg><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: noscript style block", "html": "<style>.x{display:none}</style><noscript><style>.x{display:block}</style></noscript><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: class attribute with spaces", "html": "<style>.x{display:none}</style><b id=\"t\" class=\" x \">x</b>", "chromium": "hidden"},
  {"name": "style: upper-case class both sides", "html": "<style>.X{display:none}</style><b id=\"t\" class=\"X\">x</b>", "chromium": "hidden"},
  {"name": "style: spaced declaration", "html": "<style>.x { display : none ; }</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: upper-case declaration", "html": "<style>.x{DISPLAY:NONE}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: comment in the value", "html": "<style>.x{display:none/**/}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: var() value", "html": "<style>.x{--d:none;display:var(--d)}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: @layer rule", "html": "<style>@layer a{.x{display:none}}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: @layer rule shown by an unlayered one", "html": "<style>.x{display:none}@layer a{.x{display:block !important}}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: list of simple selectors", "html": "<style>.a, .x{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: namespace selector", "html": "<style>*|b{display:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: html display none", "html": "<style>html{display:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: body hidden, child visible", "html": "<style>body{visibility:hidden}#t{visibility:visible}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: body hidden", "html": "<style>body{visibility:hidden}</style><div><b id=\"t\">x</b></div>", "chromium": "hidden"},
  {"name": "style: hex escape class", "html": "<style>.\\78{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: escaped digit class", "html": "<style>.\\31 0{display:none}</style><b id=\"t\" class=\"10\">x</b>", "chromium": "hidden"},
  {"name": "style: id selector with escape", "html": "<style>#\\74{display:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: BOM-like character in a later rule", "html": "<style>.x{display:none}.\ufeffx{display:block}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: selector over two lines", "html": "<style>.a,\n.x\n{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: rule with a string value", "html": "<style>.x{content:\"}\";display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: unterminated comment", "html": "<style>.x{display:none} /* .x{display:block}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: unclosed block", "html": "<style>.x{display:none</style><b id=\"t\" class=\"x\">x</b>", "chromium": "hidden"},
  {"name": "style: tag in svg", "html": "<style>rect{visibility:hidden}</style><svg><rect id=\"t\" width=\"5\" height=\"5\"/></svg>", "chromium": "hidden"},
  {"name": "style: html tag case in svg", "html": "<style>foreignobject{display:none}</style><svg><foreignObject><b id=\"t\">x</b></foreignObject></svg>", "chromium": "hidden"},
  {"name": "style: an @media rule loses to an inline display:none", "html": "<style>@media screen{.x{display:block}}</style><b id=\"t\" class=\"x\" style=\"display:none\">x</b>", "chromium": "hidden"},
  {"name": "style: an @media !important rule beats an inline display:none", "html": "<style>@media screen{.x{display:block !important}}</style><b id=\"t\" class=\"x\" style=\"display:none\">x</b>", "chromium": "shown"},
  {"name": "style: an @media rule and the hidden attribute", "html": "<style>@media screen{div{display:flex}}</style><div hidden><b id=\"t\">x</b></div>", "chromium": "shown"},
  {"name": "style: inline !important beats an unreadable rule", "html": "<style>.x{display:var(--d) !important}</style><b id=\"t\" class=\"x\" style=\"display:none !important\">x</b>", "chromium": "hidden"},
  {"name": "style: two ids that differ never match", "html": "<style>#a#t{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: a repeated id outranks a single one", "html": "<style>#t#t{display:block}#t{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: a class starting with a digit is invalid", "html": "<style>.123{display:none}</style><b id=\"t\" class=\"123\">x</b>", "chromium": "shown"},
  {"name": "style: an escaped leading digit is a valid class", "html": "<style>.\\31 23{display:none}</style><b id=\"t\" class=\"123\">x</b>", "chromium": "hidden"},
  {"name": "style: an id starting with a digit is invalid", "html": "<style>#\\74 , #1t{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: a universal selector after a tag is invalid", "html": "<style>b*{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: a universal selector after a class is invalid", "html": "<style>.x*{display:none}</style><b id=\"t\" class=\"x\">x</b>", "chromium": "shown"},
  {"name": "style: a tag after the universal selector is invalid", "html": "<style>*b{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: upper-case tag against svg rect", "html": "<style>RECT{display:none}</style><svg><rect id=\"t\" width=\"5\" height=\"5\"/></svg>", "chromium": "hidden"},
  {"name": "style: lower-case attribute against svg viewBox", "html": "<style>[viewbox]{display:none}</style><svg id=\"t\" viewBox=\"0 0 5 5\"></svg>", "chromium": "hidden"},
  {"name": "style: camel-case attribute against svg viewBox", "html": "<style>[viewBox]{display:none}</style><svg id=\"t\" viewBox=\"0 0 5 5\"></svg>", "chromium": "hidden"},
  {"name": "style: an escaped property name shows it again", "html": "<style>b{display:none}b{d\\69splay:block}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: an escaped property name hides", "html": "<style>b{d\\69splay:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: inline revert-layer falls back to the page rule", "html": "<style>div{visibility:hidden}b{visibility:visible}</style><div><b id=\"t\" style=\"visibility:revert-layer\">x</b></div>", "chromium": "shown"},
  {"name": "style: an animation shows a hidden element", "html": "<style>b{visibility:hidden;animation:s 1s infinite}@keyframes s{from,to{visibility:visible}}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: an inline animation shows a hidden element", "html": "<style>@keyframes s{from,to{visibility:visible}}</style><b id=\"t\" style=\"visibility:hidden;animation:s 1s infinite\">x</b>", "chromium": "shown"},
  {"name": "style: an animation loses to !important", "html": "<style>b{visibility:hidden !important;animation:s 1s infinite}@keyframes s{from,to{visibility:visible}}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: an animated display shows a hidden element", "html": "<style>b{display:none;animation:s 1s infinite}@keyframes s{from,to{display:block}}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: an opacity animation does not show", "html": "<style>b{display:none;animation:s 1s infinite}@keyframes s{from{opacity:0}to{opacity:1}}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: an alternate named stylesheet is off", "html": "<style title=\"a\">p{color:red}</style><style title=\"b\">b{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: the preferred named stylesheet applies", "html": "<style title=\"a\">b{display:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: a default namespace changes the type selector", "html": "<style>@namespace url(http://www.w3.org/2000/svg);b{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: a print stylesheet does not apply", "html": "<style media=\"print\">b{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: a stylesheet inside svg applies to the page", "html": "<svg><style>b{display:none}</style></svg><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: an unclosed attribute selector", "html": "<style>[id=t{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: a sheet wrapped in an HTML comment", "html": "<style><!-- b{display:none} --></style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: a rule after a closing comment marker", "html": "<style>i{color:red} --> b{display:none}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: a comment marker inside @media voids the rule", "html": "<style>b{display:none}@media screen{<!-- b{display:block}}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: type with a charset parameter is not applied", "html": "<style type=\"text/css; charset=utf-8\">b{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: media print in upper case", "html": "<style media=\" PRINT \">b{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: an animation on another element", "html": "<style>i{animation:s 1s infinite}@keyframes s{from,to{visibility:visible}}b{visibility:hidden}</style><b id=\"t\">x</b>", "chromium": "hidden"},
  {"name": "style: an escaped @namespace still applies", "html": "<style>@\\6e amespace url(http://www.w3.org/2000/svg);b{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: an escaped keyframe selector still animates", "html": "<style>b{visibility:hidden;animation:s 1s infinite}@keyframes s{fr\\6fm,to{visibility:visible}}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: an escaped @keyframes still animates", "html": "<style>b{visibility:hidden;animation:s 1s infinite}@\\6b eyframes s{from,to{visibility:visible}}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: a fractional keyframe selector still animates", "html": "<style>@keyframes s{.5%,to,from{visibility:visible}}</style><b id=\"t\" style=\"visibility:hidden;animation:s 1s infinite\">x</b>", "chromium": "shown"},
  {"name": "style: an @namespace escaped mid-name still applies", "html": "<style>@n\\61mespace url(http://www.w3.org/2000/svg);b{display:none}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: an @keyframes escaped mid-name still animates", "html": "<style>b{visibility:hidden;animation:s 1s infinite}@keyfr\\61mes s{from,to{visibility:visible}}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "style: an unquoted attribute value that is a number", "html": "<style>[data-x=-2]{display:none}</style><b id=\"t\" data-x=\"-2\">x</b>", "chromium": "shown"},
  {"name": "style: a quoted attribute value with a raw newline", "html": "<style>[data-x=\"a\nb\"]{display:none}</style><b id=\"t\" data-x=\"a&#10;b\">x</b>", "chromium": "shown"},
  {"name": "style: a backslash before a newline in a class", "html": "<style>.a\\\nb{display:none}</style><b id=\"t\" class=\"a b\">x</b>", "chromium": "shown"},
  {"name": "style: an attribute name that starts with a digit", "html": "<style>[2x]{display:none}</style><b id=\"t\" 2x>x</b>", "chromium": "shown"},
  {"name": "style: an unquoted custom-ident attribute value", "html": "<style>[data-x=--a]{display:none}</style><b id=\"t\" data-x=\"--a\">x</b>", "chromium": "hidden"},
  {"name": "style: :root custom properties that mention display (pub#938)", "html": "<style>:root{--font-display:swap;--gap:calc(1rem + 2px)}</style><button id=\"t\"></button>", "chromium": "shown"},
  {"name": "style: WordPress global styles presets, external sheet (pub#938)", "html": "<link rel=\"stylesheet\" href=\"data:text/css,b%7Bcolor:red%7D\"><style>:root{--wp--preset--color--black:#000000;--wp--preset--font-family--display:\"Mona Sans\", sans-serif;--wp--custom--typography--presets--6--name:Display;--wp--custom--typography--presets--6--size:clamp(2.5rem, 5vw, 4rem);--font:var(--text-display-shorthand);--wp--style--global--content-size:768px}.has-display-font-family{font-family:var(--wp--preset--font-family--display) !important}</style><button id=\"t\" class=\"has-display-font-family\"></button>", "chromium": "shown"},
  {"name": "style: :root sets visibility from a variable, a child sets visible (pub#938)", "html": "<style>:root{--v:hidden;visibility:var(--v)}</style><div style=\"visibility:visible\"><b id=\"t\">x</b></div>", "chromium": "shown"},
  {"name": "inline: a custom property holding a ; in a string (pub#938)", "html": "<b id=\"t\" style=\"--x:'a;display:none';color:red\">x</b>", "chromium": "shown"},
  {"name": "inline: a custom property holding a ; in a block, then display:block on a hidden element (pub#938)", "html": "<b id=\"t\" hidden style=\"--x:(;display:none);display:block\">x</b>", "chromium": "shown"},
  {"name": "inline: another declaration before display:none (pub#938)", "html": "<b id=\"t\" style=\"content:'x';display:none\">x</b>", "chromium": "hidden"},
  {"name": "inline: a string cut by a newline swallows the display:none after it (pub#938)", "html": "<b id=\"t\" style=\"content:'a&#10;b';display:none\">x</b>", "chromium": "shown"},
  {"name": "style: an external [hidden] !important beats a <style> show (pub#938)", "html": "<link rel=\"stylesheet\" href=\"data:text/css,%5Bhidden%5D%7Bdisplay:none!important%7D\"><style>button{display:inline-flex}</style><button id=\"t\" hidden></button>", "chromium": "hidden"},
  {"name": "inline: a display !important show beats an external [hidden] !important (pub#938)", "html": "<link rel=\"stylesheet\" href=\"data:text/css,%5Bhidden%5D%7Bdisplay:none!important%7D\"><button id=\"t\" hidden style=\"display:inline-flex !important\"></button>", "chromium": "shown"},
  {"name": "inline: a plain display show loses to an external [hidden] !important (pub#938)", "html": "<link rel=\"stylesheet\" href=\"data:text/css,%5Bhidden%5D%7Bdisplay:none!important%7D\"><button id=\"t\" hidden style=\"display:inline-flex\"></button>", "chromium": "hidden"},
  {"name": "style: an external closed-dialog !important beats a <style> show (pub#938)", "html": "<link rel=\"stylesheet\" href=\"data:text/css,dialog:not(%5Bopen%5D)%7Bdisplay:none!important%7D\"><style>dialog{display:block}</style><dialog id=\"t\"></dialog>", "chromium": "hidden"},
  {"name": "style: a <style> show of a hidden button, no external sheet (pub#938)", "html": "<style>button{display:inline-flex}</style><button id=\"t\" hidden></button>", "chromium": "shown"},
  {"name": "style: :root visibility:hidden, a child sets visible (pub#938)", "html": "<style>:root{visibility:hidden}</style><div style=\"visibility:visible\"><b id=\"t\">x</b></div>", "chromium": "shown"},
  {"name": "style: :root visibility:hidden reaches the page (pub#938)", "html": "<style>:root{visibility:hidden}</style><div><b id=\"t\">x</b></div>", "chromium": "hidden"},
  {"name": "style: a custom property naming animation beside a visibility keyframe (pub#938)", "html": "<style>@keyframes in{from{visibility:hidden}}:root{--wp--preset--animation:fade 1s}</style><b id=\"t\">x</b>", "chromium": "shown"},
  {"name": "inline: an escaped url( ends at its first ) and the display:block after it applies (pub#938)", "html": "<b id=\"t\" style=\"display:none;--x:u\\72l(();display:block\">x</b>", "chromium": "shown"},
  {"name": "inline: an escape inside a string beside display:none (pub#938)", "html": "<b id=\"t\" style=\"content:'\\201C';display:none\">x</b>", "chromium": "hidden"},
  {"name": "style: WP image link rule shows a [hidden] link", "html": "<style>.wp-block-image>a,.wp-block-image>figure>a{display:inline-block}</style><figure class=\"wp-block-image\"><a id=\"t\" hidden href=\"#\">x</a></figure>", "chromium": "shown"},
  {"name": "style: WP image link rule leaves a plain link shown", "html": "<style>.wp-block-image>a,.wp-block-image>figure>a{display:inline-block}</style><figure class=\"wp-block-image\"><a id=\"t\" href=\"#\">x</a></figure>", "chromium": "shown"},
  {"name": "style: WP lightbox button rule shows a [hidden] button", "html": "<style>.wp-lightbox-container button{align-items:center;display:flex;height:20px}</style><div class=\"wp-lightbox-container\"><button id=\"t\" hidden></button></div>", "chromium": "shown"},
  {"name": "style: a show-only rule on another parent leaves a [hidden] button hidden", "html": "<style>.wp-lightbox-container button{display:flex}</style><div class=\"other\"><button id=\"t\" hidden></button></div>", "chromium": "hidden"},
  {"name": "style: show-only rule against a decided display:none class", "html": "<style>.x{display:none}.a>b{display:flex}</style><div class=\"a\"><b id=\"t\" class=\"x\"></b></div>", "chromium": "shown"},
  {"name": "style: show-only rule loses to inline display:none", "html": "<style>.a>b{display:flex}</style><div class=\"a\"><b id=\"t\" style=\"display:none\"></b></div>", "chromium": "hidden"},
  {"name": "style: show-only rule on a closed dialog", "html": "<style>.a>dialog{display:block}</style><div class=\"a\"><dialog id=\"t\"></dialog></div>", "chromium": "shown"},
  {"name": "style: visibility:visible rule shows a child of visibility:hidden", "html": "<style>.a>b{visibility:visible}</style><div class=\"a\" style=\"visibility:hidden\"><b id=\"t\"></b></div>", "chromium": "shown"},
  {"name": "style: visibility:visible rule loses to inline visibility:hidden", "html": "<style>.a>b{visibility:visible}</style><div class=\"a\"><b id=\"t\" style=\"visibility:hidden\"></b></div>", "chromium": "hidden"},
  {"name": "style: show-only display rule does not show a visibility:hidden element", "html": "<style>.a>b{display:flex}</style><div class=\"a\" style=\"visibility:hidden\"><b id=\"t\"></b></div>", "chromium": "hidden"},
  {"name": "style: a display rule on an ancestor-only does not show a child of display:none", "html": "<style>.a>b{display:flex}</style><div class=\"a\" style=\"display:none\"><b id=\"t\"></b></div>", "chromium": "hidden"},
  {"name": "display:contents hides an input", "html": "<div><input id=\"t\" style=\"display:contents\"></div>", "chromium": "hidden"},
  {"name": "vendor display: -webkit-box on a [hidden] element beats the UA rule", "html": "<style>.x{display:-webkit-box}</style><b id=\"t\" class=\"x\" hidden></b>", "chromium": "shown"},
  {"name": "vendor display: the flexbox fallback chain on a [hidden] element", "html": "<style>.x{display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex}</style><b id=\"t\" class=\"x\" hidden></b>", "chromium": "shown"},
  {"name": "vendor display: -ms-flexbox alone is dropped by Chromium, [hidden] stays hidden", "html": "<style>.x{display:-ms-flexbox}</style><b id=\"t\" class=\"x\" hidden></b>", "chromium": "hidden"},
  {"name": "vendor display: -ms-flexbox after display:none is dropped by Chromium", "html": "<style>.x{display:none;display:-ms-flexbox}</style><b id=\"t\" class=\"x\"></b>", "chromium": "hidden"},
  {"name": "vendor display: display:none after the chain wins", "html": "<style>.x{display:-webkit-box;display:flex;display:none}</style><b id=\"t\" class=\"x\"></b>", "chromium": "hidden"},
  {"name": "vendor display: -webkit-inline-flex shown", "html": "<style>.x{display:-webkit-inline-flex}</style><b id=\"t\" class=\"x\" hidden></b>", "chromium": "shown"},
  {"name": "vendor display: descendant rule with the chain, child plain", "html": "<style>.m .i{display:-webkit-box;display:flex}</style><div class=\"m\"><div class=\"i\"><button id=\"t\"></button></div></div>", "chromium": "shown"},
  {"name": "vendor display: misspelt keyword is dropped, display:none stays", "html": "<style>.x{display:none;display:-webkit-bx}</style><b id=\"t\" class=\"x\"></b>", "chromium": "hidden"},
  {"name": "vendor display: -moz-box after display:none is dropped by Chromium", "html": "<style>.x{display:none;display:-moz-box}</style><b id=\"t\" class=\"x\"></b>", "chromium": "hidden"},
  {"name": "attr op: $= hides a matching value", "html": "<style>.o [data-a$=\"-drawer\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"cart-drawer\"></b></div>", "chromium": "hidden"},
  {"name": "attr op: $= leaves a non-matching value", "html": "<style>.o [data-a$=\"-drawer\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"cart\"></b></div>", "chromium": "shown"},
  {"name": "attr op: ^= hides", "html": "<style>.o [data-a^=\"#modal\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"#modal-1\"></b></div>", "chromium": "hidden"},
  {"name": "attr op: ^= leaves", "html": "<style>.o [data-a^=\"#modal\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"x#modal\"></b></div>", "chromium": "shown"},
  {"name": "attr op: *= hides", "html": "<style>.o [data-a*=\"closed\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"is-closed-x\"></b></div>", "chromium": "hidden"},
  {"name": "attr op: *= leaves", "html": "<style>.o [data-a*=\"closed\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"open\"></b></div>", "chromium": "shown"},
  {"name": "attr op: ~= hides a whole word", "html": "<style>.o [data-a~=\"b\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"a b c\"></b></div>", "chromium": "hidden"},
  {"name": "attr op: ~= leaves a substring", "html": "<style>.o [data-a~=\"b\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"ab c\"></b></div>", "chromium": "shown"},
  {"name": "attr op: |= hides value-", "html": "<style>.o [data-a|=\"en\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"en-US\"></b></div>", "chromium": "hidden"},
  {"name": "attr op: |= leaves a longer word", "html": "<style>.o [data-a|=\"en\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"eng\"></b></div>", "chromium": "shown"},
  {"name": "attr op: i flag matches case-blind", "html": "<style>.o [data-a$=\"DRAWER\" i]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"cart-drawer\"></b></div>", "chromium": "hidden"},
  {"name": "attr op: no flag is case-sensitive for data-*", "html": "<style>.o [data-a$=\"DRAWER\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"cart-drawer\"></b></div>", "chromium": "shown"},
  {"name": "attr op: empty ^= matches nothing", "html": "<style>.o [data-a^=\"\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"x\"></b></div>", "chromium": "shown"},
  {"name": "attr op: plain = compares the value", "html": "<style>.o [data-a=\"drawer\"]{display:none}</style><div class=\"o\"><b id=\"t\" data-a=\"other\"></b></div>", "chromium": "shown"},
  {"name": "attr op: combined list hides via the id part", "html": "<style>.o #t, .o [data-a$=\"-d\"]{display:none}</style><div class=\"o\"><b id=\"t\"></b></div>", "chromium": "hidden"}
