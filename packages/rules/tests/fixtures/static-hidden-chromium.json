[
  {"name": "plain display:none", "html": "<b id=\"t\" style=\"display:none\"></b>", "chromium": "hidden"},
  {"name": "spaces around the colon", "html": "<b id=\"t\" style=\" display : none ; \"></b>", "chromium": "hidden"},
  {"name": "upper case", "html": "<b id=\"t\" style=\"DISPLAY:NONE\"></b>", "chromium": "hidden"},
  {"name": "trailing !important", "html": "<b id=\"t\" style=\"display:none !important\"></b>", "chromium": "hidden"},
  {"name": "!important without a space", "html": "<b id=\"t\" style=\"display:none!important\"></b>", "chromium": "hidden"},
  {"name": "spaced ! important", "html": "<b id=\"t\" style=\"display:none ! important\"></b>", "chromium": "hidden"},
  {"name": "!important twice", "html": "<b id=\"t\" style=\"display:none !important !important\"></b>", "chromium": "shown"},
  {"name": "!important before the keyword", "html": "<b id=\"t\" style=\"display:!important none\"></b>", "chromium": "shown"},
  {"name": "!ie hack", "html": "<b id=\"t\" style=\"display:none !ie\"></b>", "chromium": "shown"},
  {"name": "\\9 hack", "html": "<b id=\"t\" style=\"display:none\\9\"></b>", "chromium": "shown"},
  {"name": "escape spelling the property", "html": "<b id=\"t\" style=\"dis\\play:none\"></b>", "chromium": "hidden"},
  {"name": "hex escape spelling the keyword", "html": "<b id=\"t\" style=\"display:n\\6f ne\"></b>", "chromium": "hidden"},
  {"name": "comment before the value", "html": "<b id=\"t\" style=\"display:/*x*/none\"></b>", "chromium": "hidden"},
  {"name": "comment inside the property", "html": "<b id=\"t\" style=\"dis/**/play:none\"></b>", "chromium": "shown"},
  {"name": "comment inside the keyword", "html": "<b id=\"t\" style=\"display:no/**/ne\"></b>", "chromium": "shown"},
  {"name": "no-break space before the keyword", "html": "<b id=\"t\" style=\"display:&nbsp;none\"></b>", "chromium": "shown"},
  {"name": "no-break space before the property", "html": "<b id=\"t\" style=\"&nbsp;display:none\"></b>", "chromium": "shown"},
  {"name": "undefined CSS variable", "html": "<b id=\"t\" style=\"display:var(--d)\"></b>", "chromium": "shown"},
  {"name": "defined CSS variable", "html": "<b id=\"t\" style=\"--d:none;display:var(--d)\"></b>", "chromium": "hidden"},
  {"name": "later declaration wins", "html": "<b id=\"t\" style=\"display:none;display:block\"></b>", "chromium": "shown"},
  {"name": "later none wins", "html": "<b id=\"t\" style=\"display:block;display:none\"></b>", "chromium": "hidden"},
  {"name": "!important beats a later normal one", "html": "<b id=\"t\" style=\"display:none !important;display:block\"></b>", "chromium": "hidden"},
  {"name": "invalid later value is dropped", "html": "<b id=\"t\" style=\"display:none;display:nope\"></b>", "chromium": "hidden"},
  {"name": "visibility:hidden", "html": "<b id=\"t\" style=\"visibility:hidden\"></b>", "chromium": "hidden"},
  {"name": "visibility:collapse", "html": "<b id=\"t\" style=\"visibility:collapse\"></b>", "chromium": "hidden"},
  {"name": "visibility inherited", "html": "<div style=\"visibility:hidden\"><b id=\"t\"></b></div>", "chromium": "hidden"},
  {"name": "visibility set back", "html": "<div style=\"visibility:hidden\"><b id=\"t\" style=\"visibility:visible\"></b></div>", "chromium": "shown"},
  {"name": "visibility:inherit from a hidden parent", "html": "<div style=\"visibility:hidden\"><b id=\"t\" style=\"visibility:inherit\"></b></div>", "chromium": "hidden"},
  {"name": "all:initial after display:none", "html": "<b id=\"t\" style=\"display:none;all:initial\"></b>", "chromium": "shown"},
  {"name": "display:none after all:initial", "html": "<b id=\"t\" style=\"all:initial;display:none\"></b>", "chromium": "hidden"},
  {"name": "; inside an unquoted url()", "html": "<b id=\"t\" style=\"background:url(x;display:none)\"></b>", "chromium": "shown"},
  {"name": "; inside a string", "html": "<b id=\"t\" style=\"content:'a;display:none'\"></b>", "chromium": "shown"},
  {"name": "; inside a [ block", "html": "<b id=\"t\" style=\"x:[;display:none;]\"></b>", "chromium": "shown"},
  {"name": "declaration inside braces", "html": "<b id=\"t\" style=\"{display:none}\"></b>", "chromium": "shown"},
  {"name": "vendor-prefixed property", "html": "<b id=\"t\" style=\"-webkit-display:none\"></b>", "chromium": "shown"},
  {"name": "custom property", "html": "<b id=\"t\" style=\"--display:none\"></b>", "chromium": "shown"},
  {"name": "inline-block", "html": "<b id=\"t\" style=\"display:inline-block\"></b>", "chromium": "shown"},
  {"name": "-webkit-box", "html": "<b id=\"t\" style=\"display:-webkit-box\"></b>", "chromium": "shown"},
  {"name": "two-keyword display", "html": "<b id=\"t\" style=\"display:block flow\"></b>", "chromium": "shown"},
  {"name": "display:none on an ancestor", "html": "<div style=\"display:none\"><b id=\"t\" style=\"display:block\"></b></div>", "chromium": "hidden"},
  {"name": "hidden attribute", "html": "<div hidden><b id=\"t\"></b></div>", "chromium": "hidden"},
  {"name": "hidden=until-found", "html": "<div hidden=\"until-found\"><b id=\"t\"></b></div>", "chromium": "shown"},
  {"name": "hidden with an inline display", "html": "<div hidden style=\"display:block\"><b id=\"t\"></b></div>", "chromium": "shown"},
  {"name": "hidden with display:revert", "html": "<div hidden style=\"display:revert\"><b id=\"t\"></b></div>", "chromium": "shown"},
  {"name": "closed dialog", "html": "<dialog><b id=\"t\"></b></dialog>", "chromium": "hidden"},
  {"name": "open dialog", "html": "<dialog open><b id=\"t\"></b></dialog>", "chromium": "shown"},
  {"name": "popover", "html": "<div popover><b id=\"t\"></b></div>", "chromium": "hidden"},
  {"name": "class rule in a <style> block (not read)", "html": "<style>.x{display:none}</style><b id=\"t\" class=\"x\"></b>", "chromium": "hidden"},
  {"name": "stylesheet !important beats an inline display:none", "html": "<style>b{display:block !important}</style><b id=\"t\" style=\"display:none\"></b>", "chromium": "shown", "stylesheetOverride": true},
  {"name": "stylesheet display beats the hidden attribute", "html": "<style>.flex{display:flex}</style><div hidden class=\"flex\"><b id=\"t\"></b></div>", "chromium": "shown", "stylesheetOverride": true},
  {"name": "p closed by dialog", "html": "<p style=\"display:none\"><dialog open><b id=\"t\">x</b></dialog></p>", "chromium": "shown"},
  {"name": "p closed by dialog, later content", "html": "<p style=\"display:none\"><dialog open>d</dialog><b id=\"t\">x</b></p>", "chromium": "shown"},
  {"name": "p closed by div", "html": "<p style=\"display:none\"><div><b id=\"t\">x</b></div></p>", "chromium": "shown"},
  {"name": "p closed by menu", "html": "<p style=\"display:none\"><menu><li><b id=\"t\">x</b></li></menu></p>", "chromium": "shown"},
  {"name": "p closed by search", "html": "<p style=\"display:none\"><search><b id=\"t\">x</b></search></p>", "chromium": "shown"},
  {"name": "p closed by center", "html": "<p style=\"display:none\"><center><b id=\"t\">x</b></center></p>", "chromium": "shown"},
  {"name": "p closed by hgroup", "html": "<p style=\"display:none\"><hgroup><b id=\"t\">x</b></hgroup></p>", "chromium": "shown"},
  {"name": "p closed by details", "html": "<p style=\"display:none\"><details open><b id=\"t\">x</b></details></p>", "chromium": "shown"},
  {"name": "heading inside heading", "html": "<h1 style=\"display:none\"><h2><b id=\"t\">x</b></h2></h1>", "chromium": "shown"},
  {"name": "a inside a", "html": "<a href=\"/x\" style=\"display:none\"><a href=\"/y\" id=\"t\">x</a></a>", "chromium": "shown"},
  {"name": "button inside button", "html": "<button style=\"display:none\"><button id=\"t\">x</button></button>", "chromium": "shown"},
  {"name": "li inside li", "html": "<ul><li style=\"display:none\"><li id=\"t\">x</li></li></ul>", "chromium": "shown"},
  {"name": "foster-parented out of a table", "html": "<table style=\"display:none\"><b id=\"t\">x</b></table>", "chromium": "shown"},
  {"name": "foster-parented out of a tr", "html": "<table><tr style=\"display:none\"><b id=\"t\">x</b></tr></table>", "chromium": "shown"},
  {"name": "inside a table cell", "html": "<table style=\"display:none\"><tr><td><b id=\"t\">x</b></td></tr></table>", "chromium": "hidden"},
  {"name": "form inside form", "html": "<form style=\"display:none\"><form><b id=\"t\">x</b></form></form>", "chromium": "hidden"},
  {"name": "div with hidden", "html": "<div hidden><b id=\"t\">x</b></div>", "chromium": "hidden"},
  {"name": "option closes option", "html": "<select><option style=\"display:none\"><option id=\"t\">x</select>", "chromium": "shown"},
  {"name": "dd closes dt", "html": "<dl><dt style=\"display:none\"><dd id=\"t\">x</dd></dl>", "chromium": "shown"},
  {"name": "template element shown by inline display", "html": "<template id=\"t\" style=\"display:block\"></template>", "chromium": "shown"},
  {"name": "inherited visibility overridden by a stylesheet", "html": "<style>#t{visibility:visible}</style><div style=\"visibility:hidden\"><b id=\"t\">x</b></div>", "chromium": "shown"},
  {"name": "svg presentation attribute restores visibility", "html": "<svg style=\"visibility:hidden\"><rect id=\"t\" visibility=\"visible\" width=\"5\" height=\"5\"/></svg>", "chromium": "shown"},
  {"name": "nobr inside nobr", "html": "<nobr style=\"display:none\"><nobr id=\"t\">x</nobr></nobr>", "chromium": "shown"},
  {"name": "misnested b and p", "html": "<b style=\"display:none\"><p id=\"t\">x</b>y</p>", "chromium": "shown"},
  {"name": "hidden span inside a p, closed by dialog", "html": "<p><span style=\"display:none\"><dialog open><b id=\"t\">x</b></dialog></span></p>", "chromium": "shown"},
  {"name": "hidden span inside a p, closed by div", "html": "<p><span style=\"display:none\"><div><b id=\"t\">x</b></div></span></p>", "chromium": "shown"},
  {"name": "hidden div inside an li, closed by li", "html": "<ul><li><div style=\"display:none\"><li id=\"t\">x</li></div></li></ul>", "chromium": "shown"},
  {"name": "hidden span inside a button, closed by button", "html": "<button><span style=\"display:none\"><button id=\"t\">x</button></span></button>", "chromium": "shown"},
  {"name": "hidden span inside a cell, closed by td", "html": "<table><tr><td><span style=\"display:none\"><td id=\"t\">x</td></span></td></tr></table>", "chromium": "shown"},
  {"name": "hidden div inside a link, nested link", "html": "<a href=\"/x\"><div style=\"display:none\"><a href=\"/y\" id=\"t\">x</a></div></a>", "chromium": "hidden"},
  {"name": "hidden g inside svg, HTML breaks out", "html": "<svg><g style=\"display:none\"><div><b id=\"t\">x</b></div></g></svg>", "chromium": "shown"},
  {"name": "hidden div inside an li with no nested li", "html": "<ul><li><div style=\"display:none\"><b id=\"t\">x</b></div></li></ul>", "chromium": "hidden"},
  {"name": "hidden div, span inside", "html": "<div style=\"display:none\"><span><b id=\"t\">x</b></span></div>", "chromium": "hidden"},
  {"name": "hidden section inside a div", "html": "<div><section hidden><b id=\"t\">x</b></section></div>", "chromium": "hidden"},
  {"name": "stylesheet !important beats an inline visibility:hidden", "html": "<style>#t{visibility:visible !important}</style><b id=\"t\" style=\"visibility:hidden\">x</b>", "chromium": "shown", "stylesheetOverride": true},
  {"name": "nested form closes the hidden outer form early", "html": "<form style=\"display:none\"><form></form><b id=\"t\">x</b></form>", "chromium": "shown"},
  {"name": "element named constructor", "html": "<constructor style=\"display:none\"><b id=\"t\">x</b></constructor>", "chromium": "hidden"},
  {"name": "a stray tbody outside a table is ignored", "html": "<tbody style=\"display:none\"><b id=\"t\">x</b></tbody>", "chromium": "shown"},
  {"name": "stray content in a row of a hidden table", "html": "<table style=\"display:none\"><tbody><tr><b id=\"t\">x</b></tr></tbody></table>", "chromium": "shown"},
  {"name": "content in a cell of a hidden table", "html": "<table style=\"display:none\"><tbody><tr><td><b id=\"t\">x</b></td></tr></tbody></table>", "chromium": "hidden"},
  {"name": "a td outside any table is ignored", "html": "<td style=\"display:none\"><b id=\"t\">x</b></td>", "chromium": "shown"},
  {"name": "a tbody outside any table, with valid rows", "html": "<tbody style=\"display:none\"><tr><td><b id=\"t\">x</b></td></tr></tbody>", "chromium": "shown"},
  {"name": "a head start tag inside the body is ignored", "html": "<div><head style=\"display:none\"><b id=\"t\">x</b></head></div>", "chromium": "shown"},
  {"name": "a frameset after text is ignored", "html": "text<frameset style=\"display:none\"><b id=\"t\">x</b></frameset>", "chromium": "shown"},
  {"name": "a second body start tag only lends attributes", "html": "<div><body style=\"display:none\"><b id=\"t\">x</b></body></div>", "chromium": "hidden"},
  {"name": "image becomes a void img", "html": "<image style=\"display:none\"><b id=\"t\">x</b></image>", "chromium": "shown"},
  {"name": "keygen holds nothing", "html": "<keygen style=\"display:none\"><b id=\"t\">x</b></keygen>", "chromium": "shown"},
  {"name": "open dialog with popover", "html": "<dialog id=\"t\" open popover>x</dialog>", "chromium": "shown"},
  {"name": "closed dialog with popover", "html": "<dialog id=\"t\" popover>x</dialog>", "chromium": "hidden"},
  {"name": "hidden attribute on svg", "html": "<svg id=\"t\" hidden width=\"5\" height=\"5\"></svg>", "chromium": "shown"},
  {"name": "inside an svg with the hidden attribute", "html": "<svg hidden><a id=\"t\" href=\"/x\"><text>x</text></a></svg>", "chromium": "shown"},
  {"name": "hidden attribute on an svg link", "html": "<svg><a id=\"t\" href=\"/x\" hidden><text>x</text></a></svg>", "chromium": "shown"},
  {"name": "hidden attribute on math", "html": "<math hidden><mi id=\"t\">x</mi></math>", "chromium": "shown"},
