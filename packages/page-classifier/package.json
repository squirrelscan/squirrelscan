{
  "name": "@squirrelscan/page-classifier",
  "version": "0.0.1",
  "type": "module",
  "description": "Page classifier runtime: DOM region, page type and section purpose from one featurizer and a bundled gradient-boosted artifact, with a deterministic markup fallback.",
  "exports": {
    ".": "./src/index.ts",
    "./assets/classifier-v2.json": "./assets/classifier-v2.json",
    "./assets/classifier-v2.manifest.json": "./assets/classifier-v2.manifest.json"
  },
  "dependencies": {
    "@squirrelscan/parser": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c oxlint.config.mjs src/ tests/ scripts/",
    "format": "oxfmt src/ tests/ scripts/ --write",
    "format:check": "oxfmt src/ tests/ scripts/ --check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.1",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "oxfmt": "^0.21.0",
    "oxlint": "1.73.0",
    "ultracite": "7.9.2"
  },
  "private": true,
  "license": "MIT"
}
