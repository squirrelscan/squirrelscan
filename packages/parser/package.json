{
  "name": "@squirrelscan/parser",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dom": "./src/dom.ts",
    "./extractors": "./src/extractors/index.ts",
    "./main-text": "./src/extractors/main-text.ts"
  },
  "dependencies": {
    "@squirrelscan/core-contracts": "workspace:*",
    "@squirrelscan/utils": "workspace:*",
    "effect": "^3.22.5",
    "franc": "6.2.0",
    "htmlparser2": "^10.1.0",
    "linkedom": "^0.18.12"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c oxlint.config.mjs src/ tests/",
    "format": "oxfmt -c ../../.oxfmtrc.jsonc src/ tests/ --write",
    "format:check": "oxfmt -c ../../.oxfmtrc.jsonc src/ tests/ --check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.1",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "oxfmt": "^0.21.0",
    "oxlint": "1.73.0",
    "ultracite": "7.9.2"
  },
  "private": true,
  "license": "MIT"
