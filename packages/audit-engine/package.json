    "@supabase/supabase-js": "2.118.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.1",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "oxfmt": "^0.21.0",
    "oxlint": "1.73.0",
