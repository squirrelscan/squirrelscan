    "@squirrelscan/report": "workspace:*",
    "@squirrelscan/rules": "workspace:*",
    "@squirrelscan/tech-detect": "workspace:*",
    "@squirrelscan/threat-intel": "workspace:*",
    "@squirrelscan/utils": "workspace:*",
    "@squirrelscan/waf-detect": "workspace:*",
    "effect": "^3.21.3"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.49",
